{
  // ──────────────────────────────────────────────────────────
  // tsconfig.json  — TypeScript Compiler Configuration
  //
  // LEARNING NOTE:
  //   This file tells `tsc` (the TypeScript compiler) how to
  //   behave. We DON'T define every option from scratch —
  //   instead we EXTEND Astro's recommended strict config and
  //   override only what we need.
  //
  //   "extends" works like class inheritance: we inherit all
  //   settings from the base config, then our options override.
  // ──────────────────────────────────────────────────────────

  // Extends Astro's built-in strict TypeScript preset.
  // "strict" means: noImplicitAny, strictNullChecks,
  // strictFunctionTypes, and more are ALL enabled.
  // Strict mode = maximum bug-catching power.
  "extends": "astro/tsconfigs/strict",

  "compilerOptions": {
    // The ECMAScript version to compile down to.
    // "ESNext" = use the latest JS features.
    "target": "ESNext",

    // Which module system to emit. "ESNext" means native
    // ES Modules (import/export), not CommonJS (require).
    "module": "ESNext",

    // How to resolve module imports.
    // "bundler" = trust the bundler (Vite) to handle paths.
    "moduleResolution": "bundler",

    // Path aliases — lets us write:
    //   import { nodes } from '@data/nodes.json'
    // instead of:
    //   import { nodes } from '../../data/nodes.json'
    "paths": {
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@utils/*": ["./src/utils/*"],
      "@data/*": ["./src/data/*"],
      "@types/*": ["./src/types/*"]
    },

    // Allow importing JSON files as JS modules.
    // This is how we'll load nodes.json in TypeScript.
    "resolveJsonModule": true,

    // Ensures each file can be processed independently.
    // Required for bundlers like Vite.
    "isolatedModules": true,

    // Don't emit compiled .js files — Vite handles that.
    // We only use tsc for TYPE CHECKING (npm run typecheck).
    "noEmit": true,

    // ── Strictness flags (all enabled via "extends: strict") ──
    // "strict": true           → enables all strict checks
    // "noImplicitAny": true    → error on untyped variables
    // "strictNullChecks": true → null/undefined must be handled
    // "noUnusedLocals": true   → error on unused variables
    // "noUnusedParameters": true → error on unused function params

    // Enable decorator support (useful for future frameworks).
    "experimentalDecorators": true
  },

  // Which files to include in type checking.
  // ".astro/types.d.ts" is auto-generated by Astro.
  "include": [".astro/types.d.ts", "**/*"],

  // Exclude compiled output — no need to type-check dist/.
  "exclude": ["dist", "node_modules"]
}
