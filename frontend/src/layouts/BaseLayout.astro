---
// ──────────────────────────────────────────────────────────
// frontend/src/layouts/BaseLayout.astro
//
// Complete i18n & semantic HTML5 base layout (Requirement 7).
// Manages document <html lang="..."> attribute dynamically,
// handles online/offline status, and persists language preferences.
// ──────────────────────────────────────────────────────────
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Visit Injibara • Awi Zone Eco-Tourism & Guides",
  description = "Lightweight mobile-first tourism discovery platform for Injibara and the Awi region of Ethiopia."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#020617" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Google Fonts: Plus Jakarta Sans & Noto Sans Ethiopic for authentic Amharic script -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Ethiopic:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Leaflet CSS for Map View -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-950 text-slate-100 font-sans selection:bg-emerald-600 selection:text-white">
    <!-- Top Header Bar (Persistent) -->
    <header class="sticky top-0 z-40 bg-slate-950/95 backdrop-blur border-b border-slate-800/80 px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-600 to-emerald-800 flex items-center justify-center font-black text-amber-300 text-sm shadow-md group-hover:scale-105 transition">
            VI
          </div>
          <div>
            <div id="siteHeaderTitle" class="text-xs font-extrabold tracking-wider text-white">VISIT INJIBARA</div>
            <div id="siteHeaderSubtitle" class="text-[10px] text-amber-400 font-medium">Awi Zone • አዊ ዞን</div>
          </div>
        </a>
      </div>

      <!-- Offline Indicator & Language Toggle -->
      <div class="flex items-center gap-2.5">
        <div id="connectionStatus" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-950/80 border border-emerald-500/30 text-emerald-400">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="connectionText">Online</span>
        </div>

        <!-- Language Switcher Button (EN / አማ) -->
        <button
          id="langToggleBtn"
          type="button"
          class="touch-target px-3 py-1.5 text-xs font-bold rounded-xl bg-slate-900 border border-slate-700 text-slate-200 hover:text-white hover:border-emerald-500/60 transition shadow-sm active:scale-95 flex items-center gap-1.5"
          aria-label="ቋንቋ ቀይር / Change Language"
        >
          <span class="text-amber-400">🌐</span>
          <span id="langBtnText">EN / አማ</span>
        </button>
      </div>
    </header>

    <!-- Main Page Content Slot -->
    <main class="flex-1 flex flex-col relative w-full max-w-6xl mx-auto overflow-hidden">
      <slot />
    </main>

    <!-- Global Client Script for Network Connection, SW, & Language Switching -->
    <script>
      import { translations, type Language } from '../utils/i18n';

      // 1. Service Worker registration (Requirement 9 & 5)
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(err => {
            console.log('SW registration note:', err);
          });
        });
      }

      // 2. Language State Management
      let currentLang: Language = (localStorage.getItem('user_lang') as Language) || 'en';

      function applyLanguage(lang: Language) {
        currentLang = lang;
        localStorage.setItem('user_lang', lang);
        document.documentElement.lang = lang; // Requirement 7.7

        const t = translations[lang];
        const titleEl = document.getElementById('siteHeaderTitle');
        const subEl = document.getElementById('siteHeaderSubtitle');
        const langBtnText = document.getElementById('langBtnText');
        const connText = document.getElementById('connectionText');

        if (titleEl) titleEl.textContent = t.siteTitle;
        if (subEl) subEl.textContent = t.siteSubtitle;
        if (langBtnText) langBtnText.textContent = t.toggleLangLabel;

        // Update online/offline text
        if (connText) {
          connText.textContent = navigator.onLine ? t.online : t.offline;
        }

        // Notify all views of the language change
        window.dispatchEvent(new CustomEvent('languagechange', { detail: { lang, t } }));
      }

      const langBtn = document.getElementById('langToggleBtn');
      if (langBtn) {
        langBtn.addEventListener('click', () => {
          applyLanguage(currentLang === 'en' ? 'am' : 'en');
        });
      }

      // 3. Network Status Handler
      const updateNetworkStatus = () => {
        const statusEl = document.getElementById('connectionStatus');
        const textEl = document.getElementById('connectionText');
        if (!statusEl || !textEl) return;
        const t = translations[currentLang];

        if (navigator.onLine) {
          statusEl.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-950/80 border border-emerald-500/30 text-emerald-400';
          textEl.textContent = t.online;
        } else {
          statusEl.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-950/90 border border-amber-500/40 text-amber-300';
          textEl.textContent = t.offline;
        }
      };

      window.addEventListener('online', updateNetworkStatus);
      window.addEventListener('offline', updateNetworkStatus);

      // Initialize
      applyLanguage(currentLang);
      updateNetworkStatus();
    </script>
  </body>
</html>
