---
// ──────────────────────────────────────────────────────────
// frontend/src/components/MapView.astro
//
// Interactive Leaflet map centered on Injibara (10.97°N, 36.95°E).
// Styled markers per category with bilingual tooltips and legend.
// ──────────────────────────────────────────────────────────
import type { Destination } from '../types/destination';

interface Props {
  destinations: Destination[];
}

const { destinations } = Astro.props;
---

<div id="mapContainer" class="w-full h-full relative min-h-[480px] bg-slate-950 flex flex-col">
  <!-- Map Element -->
  <div id="leafletMap" class="w-full flex-1 z-0 bg-slate-950" style="min-height: 480px;"></div>

  <!-- Loading Overlay -->
  <div id="mapLoading" class="absolute inset-0 bg-slate-950/80 backdrop-blur-sm z-20 flex flex-col items-center justify-center gap-2 transition-opacity duration-300">
    <div class="w-8 h-8 rounded-full border-2 border-emerald-500 border-t-transparent animate-spin"></div>
    <span id="mapLoadingText" class="text-xs text-slate-300 font-medium">Loading Awi Highlands Map...</span>
  </div>

  <!-- Category Legend -->
  <div class="absolute top-3 right-3 z-10 bg-slate-900/90 backdrop-blur px-2.5 py-1.5 rounded-xl border border-slate-800 text-[10px] text-slate-300 flex flex-col gap-1 shadow-lg">
    <div id="legendHeader" class="flex items-center gap-1.5 font-semibold text-slate-400 mb-0.5">Categories</div>
    <div class="flex items-center gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> <span id="leg-nature">Nature</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> <span id="leg-community">Community</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span> <span id="leg-culture">Culture</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> <span id="leg-viewpoint">Viewpoint</span>
    </div>
  </div>
</div>

<script define:vars={{ destinations }}>
  window.__DESTINATIONS__ = destinations;
</script>

<script>
  import type { Destination } from '../types/destination';
  import type { TranslationDictionary, Language } from '../utils/i18n';

  const categoryColors: Record<string, string> = {
    nature: '#10b981',
    community: '#f59e0b',
    culture: '#a855f7',
    viewpoint: '#f43f5e',
    ecology: '#059669',
    heritage: '#d97706',
  };

  const categoryIcons: Record<string, string> = {
    nature: '🌊',
    community: '🏛️',
    culture: '🏺',
    viewpoint: '🏔️',
    ecology: '🌿',
    heritage: '📜',
  };

  function initMap() {
    const mapElement = document.getElementById('leafletMap');
    const loadingOverlay = document.getElementById('mapLoading');
    if (!mapElement || !(window as any).L) return;

    const L = (window as any).L;
    const destinations: Destination[] = (window as any).__DESTINATIONS__ || [];

    const map = L.map('leafletMap', {
      zoomControl: true,
      attributionControl: true,
    }).setView([10.97, 36.95], 11);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    destinations.forEach((dest) => {
      const color = categoryColors[dest.category] || '#10b981';
      const iconEmoji = categoryIcons[dest.category] || '📍';

      const customIcon = L.divIcon({
        className: 'custom-leaflet-marker',
        html: `
          <div style="background-color: ${color}; width: 34px; height: 34px; border-radius: 50%; border: 2.5px solid #ffffff; box-shadow: 0 4px 10px rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; font-size: 14px; cursor: pointer;">
            ${iconEmoji}
          </div>
        `,
        iconSize: [34, 34],
        iconAnchor: [17, 17],
      });

      const marker = L.marker([dest.lat, dest.lng], {
        icon: customIcon,
        keyboard: true,
        title: `${dest.title} (${dest.local_name})`
      }).addTo(map);

      marker.on('click', () => {
        window.dispatchEvent(new CustomEvent('selectdestination', { detail: { destination: dest } }));
      });
    });

    if (loadingOverlay) {
      loadingOverlay.classList.add('opacity-0', 'pointer-events-none');
    }
  }

  if (!(window as any).L) {
    const script = document.createElement('script');
    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    script.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
    script.crossOrigin = '';
    script.onload = initMap;
    document.head.appendChild(script);
  } else {
    initMap();
  }

  // Language update listener for Map Legend
  window.addEventListener('languagechange', ((e: CustomEvent<{ lang: Language; t: TranslationDictionary }>) => {
    const { t } = e.detail;
    const legNature = document.getElementById('leg-nature');
    const legComm = document.getElementById('leg-community');
    const legCult = document.getElementById('leg-culture');
    const legView = document.getElementById('leg-viewpoint');
    const loadText = document.getElementById('mapLoadingText');

    if (legNature) legNature.textContent = t.categories.nature;
    if (legComm) legComm.textContent = t.categories.community;
    if (legCult) legCult.textContent = t.categories.culture;
    if (legView) legView.textContent = t.categories.viewpoint;
    if (loadText) loadText.textContent = t.online;
  }) as EventListener);
</script>
