---
// ──────────────────────────────────────────────────────────
// frontend/src/components/DetailPanel.astro
//
// Overlay / Bottom-sheet component displaying destination details.
// Features full Amharic and English localization.
// ──────────────────────────────────────────────────────────
---

<div
  id="detailPanel"
  class="fixed sm:absolute bottom-0 inset-x-0 bg-slate-900/98 backdrop-blur-xl border-t-2 border-emerald-500 rounded-t-3xl sm:rounded-2xl shadow-2xl transition-all duration-300 transform translate-y-full z-40 max-w-xl mx-auto overflow-hidden flex flex-col max-h-[85vh]"
  role="dialog"
  aria-labelledby="panelTitle"
  aria-modal="true"
>
  <!-- Mobile Drawer Drag Handle -->
  <div class="w-12 h-1.5 bg-slate-700/80 rounded-full mx-auto mt-2.5 mb-1 cursor-grab sm:hidden"></div>

  <!-- Hero Photo Banner with Gradient Overlay -->
  <div class="relative w-full h-44 sm:h-52 bg-slate-950 flex-shrink-0 overflow-hidden">
    <img
      id="panelHeroImage"
      src=""
      alt="Destination photo"
      class="w-full h-full object-cover transition-opacity duration-300"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>

    <!-- Close Button -->
    <button
      id="panelCloseBtn"
      type="button"
      class="touch-target absolute top-3 right-3 w-9 h-9 rounded-full bg-slate-950/80 hover:bg-slate-900 text-slate-200 hover:text-white flex items-center justify-center transition border border-slate-700/80 shadow-lg"
      aria-label="ዝጋ / Close"
    >
      ✕
    </button>

    <!-- Category & Altitude Badges over Photo -->
    <div class="absolute bottom-3 left-4 flex items-center gap-2 flex-wrap">
      <span id="panelCategory" class="px-2.5 py-1 rounded-lg text-[11px] font-extrabold uppercase tracking-wider bg-emerald-600 text-white shadow-md">
        NATURE
      </span>
      <span id="panelAltitude" class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-slate-950/80 text-amber-300 border border-amber-500/30 backdrop-blur-sm">
        2,400m
      </span>
    </div>
  </div>

  <!-- Scrollable Content Body -->
  <div class="p-4 sm:p-5 overflow-y-auto space-y-3.5">
    <!-- Title & Local Name in Amharic -->
    <div>
      <h3 id="panelTitle" class="text-xl sm:text-2xl font-black text-white tracking-tight">
        Lake Zengena
      </h3>
      <p id="panelLocalName" class="text-sm sm:text-base text-amber-400 font-bold font-serif mt-0.5">
        ዘንጌና ሐይቅ
      </p>
    </div>

    <!-- Clear, Highly Readable Description -->
    <p id="panelDescription" class="text-sm text-slate-200 leading-relaxed font-normal bg-slate-950/40 p-3 rounded-xl border border-slate-800/60">
      Loading description...
    </p>

    <!-- Road & Seasonal Advisory Card -->
    <div class="p-3 bg-amber-950/30 border border-amber-500/40 rounded-xl text-xs flex items-start gap-2.5">
      <span class="text-amber-400 text-base flex-shrink-0">⚠️</span>
      <div>
        <div id="panelAdvisoryHeader" class="font-extrabold text-amber-200 uppercase tracking-wide text-[10px]">
          Getting There & Seasonal Advice
        </div>
        <p id="panelWarning" class="text-amber-200/90 mt-0.5 font-medium leading-normal"></p>
      </div>
    </div>

    <!-- Verified Guide Booking Section -->
    <div class="pt-2 border-t border-slate-800/80">
      <div class="flex items-center justify-between mb-2.5">
        <span id="panelGuideHeader" class="text-xs font-bold text-slate-200 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Connect with Verified Youth Guide
        </span>
        <span id="panelVerifiedDate" class="text-[10px] text-slate-400 font-medium">
          Verified: --
        </span>
      </div>

      <!-- Contact Buttons Grid (min 44px touch targets) -->
      <div id="guideActionsContainer" class="grid grid-cols-3 gap-2">
        <!-- Direct Phone Call -->
        <a
          id="linkCall"
          href="#"
          class="touch-target flex items-center justify-center gap-1.5 py-3 px-2 bg-slate-800 hover:bg-slate-700 active:scale-95 text-white rounded-xl text-xs font-bold border border-slate-700 transition shadow-sm"
        >
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
          </svg>
          <span id="labelCallBtn">Call</span>
        </a>

        <!-- WhatsApp Chat -->
        <a
          id="linkWhatsApp"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="touch-target flex items-center justify-center gap-1.5 py-3 px-2 bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white rounded-xl text-xs font-bold shadow-md shadow-emerald-950/60 transition"
        >
          <span id="labelWhatsAppBtn">WhatsApp</span>
        </a>

        <!-- Telegram Chat -->
        <a
          id="linkTelegram"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="touch-target flex items-center justify-center gap-1.5 py-3 px-2 bg-sky-600 hover:bg-sky-500 active:scale-95 text-white rounded-xl text-xs font-bold shadow-md shadow-sky-950/60 transition"
        >
          <span id="labelTelegramBtn">Telegram</span>
        </a>
      </div>

      <!-- When Guide is Not Assigned -->
      <div id="guideUnavailable" class="hidden p-3 bg-slate-800/50 rounded-xl text-center text-xs text-slate-400 border border-slate-700/50">
        No verified youth guide is currently registered for this site.
      </div>
    </div>
  </div>
</div>

<script>
  import type { TranslationDictionary, Language } from '../utils/i18n';

  const closeBtn = document.getElementById('panelCloseBtn');
  const panel = document.getElementById('detailPanel');

  if (closeBtn && panel) {
    closeBtn.addEventListener('click', () => {
      panel.classList.add('translate-y-full');
    });
  }

  // Language update listener for static UI elements in panel
  window.addEventListener('languagechange', ((e: CustomEvent<{ lang: Language; t: TranslationDictionary }>) => {
    const { t } = e.detail;
    const advHeader = document.getElementById('panelAdvisoryHeader');
    const guideHeader = document.getElementById('panelGuideHeader');
    const callText = document.getElementById('labelCallBtn');
    const waText = document.getElementById('labelWhatsAppBtn');
    const tgText = document.getElementById('labelTelegramBtn');
    const unavail = document.getElementById('guideUnavailable');

    if (advHeader) advHeader.textContent = t.detail.roadAndSeasonTitle;
    if (guideHeader) {
      guideHeader.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> ${t.detail.guideTitle}`;
    }
    if (callText) callText.textContent = t.detail.callBtn;
    if (waText) waText.textContent = t.detail.whatsappBtn;
    if (tgText) tgText.textContent = t.detail.telegramBtn;
    if (unavail) unavail.textContent = t.detail.noGuideMsg;
  }) as EventListener);
</script>
