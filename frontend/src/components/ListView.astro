---
// ──────────────────────────────────────────────────────────
// frontend/src/components/ListView.astro
//
// Browsable destination card grid with dynamic Amharic & English localization.
// ──────────────────────────────────────────────────────────
import type { Destination } from '../types/destination';

interface Props {
  destinations: Destination[];
}

const { destinations } = Astro.props;
---

<div id="listContainer" class="w-full h-full p-4 sm:p-6 overflow-y-auto max-w-4xl mx-auto space-y-4">
  <div class="flex items-center justify-between pb-2 border-b border-slate-800">
    <div>
      <h2 id="listMainHeading" class="text-base sm:text-lg font-black text-white tracking-tight">
        Discover Awi & Injibara
      </h2>
      <p id="listSubHeading" class="text-xs text-slate-400 mt-0.5">
        Explore natural wonders, cultural centers & mountain viewpoints
      </p>
    </div>
    <span class="text-xs font-bold text-emerald-400 bg-emerald-950/80 px-2.5 py-1 rounded-full border border-emerald-800">
      <span id="listCountNumber">{destinations.length}</span> <span id="listCountLabel">Sites</span>
    </span>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    {destinations.map((dest) => (
      <div
        class="destination-card bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden hover:border-emerald-500/50 cursor-pointer transition shadow-lg flex flex-col group touch-target"
        data-dest-id={dest.id}
        tabindex="0"
        role="button"
      >
        <!-- Card Photo Banner -->
        <div class="relative w-full h-36 bg-slate-950 overflow-hidden">
          <img
            src={dest.image_url}
            alt={dest.title}
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent"></div>

          <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5">
            <span
              id={`card-cat-${dest.id}`}
              class="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-md bg-slate-950/80 text-white backdrop-blur border border-slate-700/60"
            >
              {dest.category}
            </span>
          </div>

          <div class="absolute bottom-2 left-2.5">
            <span class="text-[11px] font-bold text-amber-300 bg-slate-950/90 px-2 py-0.5 rounded-md border border-amber-500/20">
              {dest.altitude_m}m
            </span>
          </div>
        </div>

        <!-- Card Body -->
        <div class="p-3.5 flex-1 flex flex-col justify-between">
          <div>
            <h3
              id={`card-title-${dest.id}`}
              class="text-base font-black text-white group-hover:text-emerald-300 transition"
            >
              {dest.title}
            </h3>
            <p
              id={`card-subtitle-${dest.id}`}
              class="text-xs text-amber-400 font-bold font-serif mt-0.5"
            >
              {dest.local_name}
            </p>

            <p
              id={`card-desc-${dest.id}`}
              class="text-xs text-slate-300 mt-2 line-clamp-2 leading-relaxed font-normal"
            >
              {dest.description}
            </p>
          </div>

          <div class="mt-3 pt-2.5 border-t border-slate-800/80 flex items-center justify-between text-xs">
            {dest.guide_phone && dest.last_verified ? (
              <span id={`card-guide-status-${dest.id}`} class="text-[11px] text-emerald-400 font-bold flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Verified Guide
              </span>
            ) : (
              <span id={`card-guide-status-${dest.id}`} class="text-[11px] text-slate-500 font-medium">Self-guided</span>
            )}
            <span id={`card-explore-btn-${dest.id}`} class="text-emerald-400 font-bold group-hover:translate-x-1 transition text-xs">
              View Guide & Advice →
            </span>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  import type { Destination } from '../types/destination';
  import type { TranslationDictionary, Language } from '../utils/i18n';

  const cards = document.querySelectorAll<HTMLElement>('.destination-card');
  const destinations: Destination[] = (window as any).__DESTINATIONS__ || [];

  cards.forEach(card => {
    const id = card.dataset.destId;
    if (!id) return;

    const select = () => {
      const dest = destinations.find(d => d.id === id);
      if (dest) {
        window.dispatchEvent(new CustomEvent('selectdestination', { detail: { destination: dest } }));
      }
    };

    card.addEventListener('click', select);
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        select();
      }
    });
  });

  // Language change listener for Card List View
  window.addEventListener('languagechange', ((e: CustomEvent<{ lang: Language; t: TranslationDictionary }>) => {
    const { lang, t } = e.detail;

    const mainHeading = document.getElementById('listMainHeading');
    const subHeading = document.getElementById('listSubHeading');
    const countLabel = document.getElementById('listCountLabel');

    if (mainHeading) mainHeading.textContent = t.list.title;
    if (subHeading) subHeading.textContent = t.list.subtitle;
    if (countLabel) countLabel.textContent = t.list.sitesCount;

    destinations.forEach(dest => {
      const titleEl = document.getElementById(`card-title-${dest.id}`);
      const subTitleEl = document.getElementById(`card-subtitle-${dest.id}`);
      const descEl = document.getElementById(`card-desc-${dest.id}`);
      const catEl = document.getElementById(`card-cat-${dest.id}`);
      const guideStatusEl = document.getElementById(`card-guide-status-${dest.id}`);
      const exploreBtnEl = document.getElementById(`card-explore-btn-${dest.id}`);

      if (catEl) {
        catEl.textContent = t.categories[dest.category] || dest.category;
      }
      if (exploreBtnEl) {
        exploreBtnEl.textContent = t.list.exploreBtn;
      }

      if (guideStatusEl) {
        if (dest.guide_phone && dest.last_verified) {
          guideStatusEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> ${t.list.guideAvailable}`;
        } else {
          guideStatusEl.textContent = t.list.selfGuided;
        }
      }

      if (lang === 'am') {
        if (titleEl) titleEl.textContent = dest.local_name;
        if (subTitleEl) subTitleEl.textContent = dest.title;
        if (descEl) descEl.textContent = dest.description_am || dest.description;
      } else {
        if (titleEl) titleEl.textContent = dest.title;
        if (subTitleEl) subTitleEl.textContent = dest.local_name;
        if (descEl) descEl.textContent = dest.description;
      }
    });
  }) as EventListener);
</script>
