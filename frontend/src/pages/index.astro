---
// ──────────────────────────────────────────────────────────
// frontend/src/pages/index.astro  — Main Application Viewport
//
// Integrates:
// 1. Data loading with build-time validation (Requirement 1)
// 2. Base layout & persistent view switcher (Requirement 4)
// 3. Map View (Leaflet), Graph View (SVG), and List View (Requirements 2, 3)
// 4. Interactive Detail Panel with Youth Guide Contact deep links (Requirement 6)
// 5. Full Amharic & English localization state management (Requirement 7)
// ──────────────────────────────────────────────────────────
import BaseLayout from '../layouts/BaseLayout.astro';
import ViewSwitcher from '../components/ViewSwitcher.astro';
import MapView from '../components/MapView.astro';
import GraphView from '../components/GraphView.astro';
import ListView from '../components/ListView.astro';
import DetailPanel from '../components/DetailPanel.astro';

import rawNodes from '../data/nodes.json';
import { getValidatedNodes } from '../utils/validator';

// Validate destination data at build time (Requirement 1.7)
const destinations = getValidatedNodes(rawNodes);
---

<BaseLayout>
  <!-- Persistent View Switcher Control -->
  <ViewSwitcher />

  <!-- Viewports Container -->
  <div class="relative flex-1 w-full flex flex-col overflow-hidden">
    <!-- 1. Interactive Map View -->
    <div id="viewport-map" class="viewport-panel w-full flex-1 flex flex-col">
      <MapView destinations={destinations} />
    </div>

    <!-- 2. Relational Graph View -->
    <div id="viewport-graph" class="viewport-panel w-full flex-1 hidden flex-col">
      <GraphView destinations={destinations} />
    </div>

    <!-- 3. Accessible Destination List -->
    <div id="viewport-list" class="viewport-panel w-full flex-1 hidden flex-col">
      <ListView destinations={destinations} />
    </div>

    <!-- Interactive Bottom Sheet / Detail Panel -->
    <DetailPanel />
  </div>
</BaseLayout>

<script>
  import { buildContactActions, hasVerifiedContact } from '../utils/contacts';
  import { translations, type Language, type TranslationDictionary } from '../utils/i18n';
  import type { Destination } from '../types/destination';

  let currentLang: Language = (localStorage.getItem('user_lang') as Language) || 'en';
  let activeDestination: Destination | null = null;

  // 1. Handle View Switching (Requirement 4)
  window.addEventListener('viewchange', ((e: CustomEvent<{ view: string }>) => {
    const activeView = e.detail.view;
    ['map', 'graph', 'list'].forEach(v => {
      const panel = document.getElementById(`viewport-${v}`);
      if (panel) {
        if (v === activeView) {
          panel.classList.remove('hidden');
          panel.classList.add('flex');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('flex');
        }
      }
    });
  }) as EventListener);

  // 2. Render Destination Details in Drawer
  function renderDetail(dest: Destination, lang: Language) {
    const panel = document.getElementById('detailPanel');
    if (!dest || !panel) return;
    activeDestination = dest;

    const t = translations[lang];

    const imageEl = document.getElementById('panelHeroImage') as HTMLImageElement;
    const titleEl = document.getElementById('panelTitle');
    const localEl = document.getElementById('panelLocalName');
    const catEl = document.getElementById('panelCategory');
    const altEl = document.getElementById('panelAltitude');
    const descEl = document.getElementById('panelDescription');
    const warnEl = document.getElementById('panelWarning');
    const dateEl = document.getElementById('panelVerifiedDate');

    if (imageEl) {
      imageEl.src = dest.image_url || 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80';
      imageEl.alt = `${dest.title} - ${dest.local_name}`;
    }

    if (lang === 'am') {
      if (titleEl) titleEl.textContent = dest.local_name;
      if (localEl) localEl.textContent = dest.title;
      if (descEl) descEl.textContent = dest.description_am || dest.description;
      if (warnEl) {
        const veh = dest.vehicle_am || dest.vehicle;
        const sea = dest.seasonal_warnings_am || dest.seasonal_warnings;
        warnEl.textContent = `${veh}። ${sea}`;
      }
    } else {
      if (titleEl) titleEl.textContent = dest.title;
      if (localEl) localEl.textContent = dest.local_name;
      if (descEl) descEl.textContent = dest.description;
      if (warnEl) warnEl.textContent = `${dest.vehicle}. ${dest.seasonal_warnings}`;
    }

    if (catEl) {
      catEl.textContent = (t.categories[dest.category] || dest.category).toUpperCase();
    }
    if (altEl) {
      altEl.textContent = `${dest.altitude_m}m ${t.detail.elevationSuffix}`;
    }
    if (dateEl) {
      dateEl.textContent = `${t.detail.verifiedOn}: ${dest.last_verified || t.detail.unverified}`;
    }

    // Guide actions (Requirement 6)
    const actionsBox = document.getElementById('guideActionsContainer');
    const unavailBox = document.getElementById('guideUnavailable');

    if (hasVerifiedContact(dest.guide_phone, dest.last_verified)) {
      const actions = buildContactActions(dest.guide_phone!, lang === 'am' ? dest.local_name : dest.title);
      const callBtn = document.getElementById('linkCall') as HTMLAnchorElement;
      const waBtn = document.getElementById('linkWhatsApp') as HTMLAnchorElement;
      const tgBtn = document.getElementById('linkTelegram') as HTMLAnchorElement;

      if (callBtn) callBtn.href = actions.call;
      if (waBtn) waBtn.href = actions.whatsapp;
      if (tgBtn) tgBtn.href = actions.telegram;

      if (actionsBox) actionsBox.classList.remove('hidden');
      if (unavailBox) unavailBox.classList.add('hidden');
    } else {
      if (actionsBox) actionsBox.classList.add('hidden');
      if (unavailBox) unavailBox.classList.remove('hidden');
    }

    // Slide up Drawer
    panel.classList.remove('translate-y-full');
    panel.classList.add('translate-y-0');
  }

  // 3. Listen for Destination Selection Event
  window.addEventListener('selectdestination', ((e: CustomEvent<{ destination: Destination }>) => {
    renderDetail(e.detail.destination, currentLang);
  }) as EventListener);

  // 4. Re-render drawer if language is toggled while open
  window.addEventListener('languagechange', ((e: CustomEvent<{ lang: Language; t: TranslationDictionary }>) => {
    currentLang = e.detail.lang;
    if (activeDestination) {
      renderDetail(activeDestination, currentLang);
    }
  }) as EventListener);
</script>
